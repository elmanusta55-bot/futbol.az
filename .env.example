# Copy this file to .env and fill in your values
# NEVER commit .env to version control

# API-Football (api-sports.io) key
# Get your key at: https://dashboard.api-football.com/
APISPORTS_KEY=your_api_football_key_here

# Football-Data.org API key – used for live match scores & goal notifications
# Get your free key at: https://www.football-data.org/
FOOTBALL_DATA_KEY=your_football_data_key_here

# NewsAPI key (optional). If empty, backend returns mock football news cards.
NEWS_API_KEY=your_newsapi_key_here

# Telegram bot notifications (optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Server port (default: 3000)
PORT=3000

# Environment
NODE_ENV=production
